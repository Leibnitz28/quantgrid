# QuantGrid configuration (all variables are optional; defaults shown).
# Copy to .env and adjust. NEVER commit real secrets.

# --- infrastructure -------------------------------------------------------------
QG_ENV=dev
QG_DATABASE_URL=postgresql+psycopg://quantgrid:quantgrid@127.0.0.1:5433/quantgrid
QG_REDIS_URL=redis://127.0.0.1:6380/0
# QG_BROKER_URL=            # defaults to QG_REDIS_URL
QG_QUEUE_NAME=quantgrid.tasks

# --- storage ----------------------------------------------------------------------
QG_DATA_DIR=var/data              # materialised (synthetic) datasets
QG_ARTIFACT_ROOT=var/artifacts    # content-addressed result artifacts
QG_AUTO_MATERIALIZE_DATASETS=true

# --- scheduler --------------------------------------------------------------------
QG_LEASE_TTL_S=15
QG_HEARTBEAT_INTERVAL_S=3
QG_WORKER_DEAD_AFTER_S=15
QG_COORDINATOR_TICK_S=0.5
QG_DISPATCH_WINDOW_FACTOR=2
QG_DISPATCH_MIN_WINDOW=4
QG_DISPATCH_LOST_AFTER_S=120
QG_RETRY_BACKOFF_BASE_S=1
QG_RETRY_BACKOFF_MAX_S=30

# --- API --------------------------------------------------------------------------
# Comma separated "<api-key>:<user-id>" pairs. Replace the dev key outside local dev.
QG_API_KEYS=dev-key:dev-user
QG_MAX_REQUEST_BYTES=262144
QG_RATE_LIMIT_PER_MINUTE=600
QG_PLANNER_RATE_LIMIT_PER_MINUTE=30

# --- quotas (per user) ------------------------------------------------------------
QG_QUOTA_MAX_TASKS_PER_BATCH=5000
QG_QUOTA_MAX_RUNTIME_S_PER_TASK=900
QG_QUOTA_MAX_MEMORY_MB_PER_TASK=2048
QG_QUOTA_MAX_WORKER_SECONDS_PER_BATCH=43200
QG_QUOTA_MAX_ACTIVE_BATCHES=20
QG_QUOTA_MAX_ATTEMPTS=10
QG_QUOTA_MAX_BOOTSTRAP_SAMPLES=20000
QG_QUOTA_ALLOWED_DATASETS=        # empty = every registered dataset
QG_ALLOW_FAULT_INJECTION=false    # demos/tests set true to inject failures

# --- observability ----------------------------------------------------------------
QG_LOG_LEVEL=INFO
QG_LOG_FORMAT=json                # json | console
QG_OTEL_EXPORTER=none             # none | console | otlp (otlp needs the "otlp" extra)
# QG_OTEL_ENDPOINT=http://localhost:4318/v1/traces
QG_COORDINATOR_METRICS_PORT=0     # 0 = disabled
QG_WORKER_METRICS_PORT=0

# --- AI planner -------------------------------------------------------------------
QG_LLM_PROVIDER=fake              # fake (deterministic, default) | anthropic (optional)
QG_LLM_MODEL=claude-opus-5-5
QG_LLM_EFFORT=medium
QG_LLM_TIMEOUT_S=60
QG_AGENT_MAX_STEPS=8
QG_AGENT_MAX_TOOL_CALLS=16
QG_AGENT_TIMEOUT_S=120
# ANTHROPIC_API_KEY=              # only needed when QG_LLM_PROVIDER=anthropic (install extra "llm")
